<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RemoteDesktopPlus.Views.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="关于" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource CanvasBrush}" Icon="/app.ico" xmlns:views="clr-namespace:RemoteDesktopPlus.Views;assembly=小马远程桌面">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
      <Border Width="56" Height="56" CornerRadius="15" Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Center" Margin="0,0,16,0">
        <UIElement.Effect>
          <DropShadowEffect Color="#2563EB" Opacity="0.4" BlurRadius="18" ShadowDepth="3" Direction="270" />
        </UIElement.Effect>
        <Grid>
          <Border CornerRadius="15,15,0,0" VerticalAlignment="Top" Height="18" Background="{StaticResource CardTopHighlightBrush}" />
          <Path Data="M5,5 L11,5 L11,11 L17,11 L17,17 L11,17 L11,11 L5,11" Fill="#FFFFFFFF" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="小马远程桌面" Style="{StaticResource DisplayTitle}" FontSize="20" />
        <TextBlock Text="Remote Desktop Plus" FontSize="11" FontWeight="Medium" Foreground="{StaticResource InkSubtleBrush}" Margin="0,2,0,0" />
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource InsetBlock}" Padding="18,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Style="{StaticResource FieldLabel}" />
        <TextBlock Name="VersionText" Grid.Row="0" Grid.Column="1" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="技术" Style="{StaticResource FieldLabel}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text=".NET 8 · WPF" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="4" Grid.Column="0" Text="作者" Style="{StaticResource FieldLabel}" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="马欣" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="6" Grid.Column="0" Text="版权" Style="{StaticResource FieldLabel}" />
        <TextBlock Grid.Row="6" Grid.Column="1" Text="© 2026 马欣 · MIT License" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <TextBlock Grid.Row="2" Margin="2,16,2,0" Style="{StaticResource HelperText}" TextWrapping="Wrap" Text="轻量远程桌面连接管理工具：连接记录、凭证加密保存、批量在线检测。默认全盘符双向共享与剪贴板互通，连接成功即自动保存；内置流畅优先档（低带宽低渲染负担）适配无 GPU 的虚拟机与弱带宽链路；分辨率默认让远程桌面窗口最大化铺满可用区域且不遮任务栏。" />
    <Button Grid.Row="3" Content="确 定" MinWidth="100" Height="40" HorizontalAlignment="Right" Margin="0,22,0,0" Style="{StaticResource ButtonPrimary}" IsDefault="True" IsCancel="True" Click="Ok_Click" />
  </Grid>
</Window>