<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RemoteDesktopPlus.Views.SetLaunchPasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设置启动密码" Width="430" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource CanvasBrush}" Icon="/app.ico" xmlns:views="clr-namespace:RemoteDesktopPlus.Views;assembly=小马远程桌面">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="设置启动密码" Style="{StaticResource DisplayTitle}" FontSize="20" Margin="0,0,0,4" />
      <TextBlock Text="设置后，下次启动需输入密码才能进入程序。留空表示移除密码。" Style="{StaticResource HelperText}" />
    </StackPanel>
    <StackPanel Grid.Row="1">
      <TextBlock Style="{StaticResource Eyebrow}" Text="原密码（首次设置可留空）" Margin="0,0,0,6" />
      <PasswordBox Name="OldPwd" Margin="0,0,0,14" />
      <TextBlock Style="{StaticResource Eyebrow}" Text="新密码" Margin="0,0,0,6" />
      <PasswordBox Name="NewPwd" Margin="0,0,0,14" />
      <TextBlock Style="{StaticResource Eyebrow}" Text="确认新密码" Margin="0,0,0,6" />
      <PasswordBox Name="ConfirmPwd" />
    </StackPanel>
    <Grid Row="2" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" Content="取消" MinWidth="80" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Grid.Column="2" Content="保存" MinWidth="100" Style="{StaticResource ButtonPrimary}" IsDefault="True" Click="Ok_Click" />
    </Grid>
  </Grid>
</Window>