<?xml version="1.0" encoding="utf-8"?>
<!-- 设置窗口（v1.2.0，枢联 1.10 移植）：mstsc 风格原生项，5 页签。
     直接绑定 Owner 的 MainViewModel（公共可观察属性），开关写回由 VM 的
     OnXxxChanged 持久化 —— 无需独立 ViewModel。
     生效语义（冲突项 C4）：「显示模式」选预设时，单项页签禁用（灰色），.rdp 走
     AppendPerformanceKeys；选自定义时按各页签逐键写出（RdpOptions.DisplayMode）。 -->
<Window x:Class="RemoteDesktopPlus.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设置" Width="560" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource CanvasBrush}" Icon="/app.ico" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TabControl Grid.Row="0" Grid.RowSpan="2" Name="NavTabs" Background="Transparent" BorderThickness="0">
      <TabItem Header="常规">
        <StackPanel Margin="8,16,8,8">
          <Border Style="{StaticResource InsetBlock}" Padding="18,14">
            <StackPanel>
              <CheckBox Content="开机自动启动（登录时静默进入托盘）" IsChecked="{Binding AutoStart}" ToolTip="通过 Windows 计划任务实现（最高权限，无 UAC 弹窗）。若已设置启动密码，开机拉起后仍需输入密码解锁。" />
              <CheckBox Content="窗口置顶" IsChecked="{Binding Topmost}" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource InsetBlock}" Padding="18,14" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="托盘行为" />
              <CheckBox Content="点关闭按钮时隐藏到托盘（关闭 = 真退出）" IsChecked="{Binding CloseToTray}" Margin="0,10,0,0" />
              <CheckBox Content="最小化时隐藏到托盘" IsChecked="{Binding MinimizeToTray}" Margin="0,10,0,0" />
              <CheckBox Content="按 ESC 隐藏到托盘" IsChecked="{Binding EscToTray}" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="显示">
        <StackPanel Margin="8,16,8,8">
          <TextBlock Style="{StaticResource HelperText}" TextWrapping="Wrap" Text="显示模式决定 .rdp 生成策略：性能预设按「流畅优先」整组调优（推荐，默认）；自定义时按下方各页签单项逐键生效。" />
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <RadioButton Content="性能预设（流畅优先）" GroupName="DisplayMode" IsChecked="{Binding IsPerformancePreset}" VerticalAlignment="Center" />
            <RadioButton Content="自定义" GroupName="DisplayMode" IsChecked="{Binding IsCustomDisplay}" Margin="24,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Border Style="{StaticResource InsetBlock}" Padding="18,14" Margin="0,14,0,0" IsEnabled="{Binding IsCustomDisplay}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="色深" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" MinHeight="36" Width="160" HorizontalAlignment="Left" ItemsSource="{Binding ColorDepthOptions}" SelectedItem="{Binding SelectedColorDepth}" />
              </Grid>
              <CheckBox Content="使用多台显示器" IsChecked="{Binding UseMultiMon}" Margin="0,12,0,0" />
              <CheckBox Content="显示连接栏" IsChecked="{Binding ShowConnectionBar}" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="本地资源">
        <StackPanel Margin="8,16,8,8">
          <Border Style="{StaticResource InsetBlock}" Padding="18,14" IsEnabled="{Binding IsCustomDisplay}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="音频" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" MinHeight="36" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding AudioModeOptions}" SelectedItem="{Binding SelectedAudioMode}" />
              </Grid>
              <CheckBox Content="打印机重定向" IsChecked="{Binding RedirectPrinters}" Margin="0,12,0,0" />
              <TextBlock Style="{StaticResource HelperText}" TextWrapping="Wrap" Margin="0,10,0,0" Text="盘符/剪贴板重定向在主界面「显示与挂载」区配置；分组级覆盖仍然优先生效。" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="体验">
        <StackPanel Margin="8,16,8,8">
          <Border Style="{StaticResource InsetBlock}" Padding="18,14" IsEnabled="{Binding IsCustomDisplay}">
            <StackPanel>
              <CheckBox Content="允许字体平滑" IsChecked="{Binding AllowFontSmoothing}" />
              <CheckBox Content="允许桌面合成" IsChecked="{Binding AllowDesktopComposition}" Margin="0,12,0,0" />
              <CheckBox Content="禁用壁纸" IsChecked="{Binding DisableWallpaper}" Margin="0,12,0,0" />
              <CheckBox Content="禁用全窗口拖动" IsChecked="{Binding DisableFullWindowDrag}" Margin="0,12,0,0" />
              <CheckBox Content="禁用菜单动画" IsChecked="{Binding DisableMenuAnims}" Margin="0,12,0,0" />
              <CheckBox Content="禁用主题" IsChecked="{Binding DisableThemes}" Margin="0,12,0,0" />
              <CheckBox Content="持久位图缓存" IsChecked="{Binding BitmapCachePersist}" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="高级">
        <StackPanel Margin="8,16,8,8">
          <Border Style="{StaticResource InsetBlock}" Padding="18,14" IsEnabled="{Binding IsCustomDisplay}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="键盘钩子" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" MinHeight="36" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding KeyboardHookOptions}" SelectedItem="{Binding SelectedKeyboardHook}" />
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="服务器身份验证" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" MinHeight="36" Width="260" HorizontalAlignment="Left" ItemsSource="{Binding AuthLevelOptions}" SelectedItem="{Binding SelectedAuthLevel}" />
              </Grid>
              <CheckBox Content="自动重连" IsChecked="{Binding AutoReconnect}" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>
    <Button Grid.Row="2" Content="关 闭" MinWidth="100" Height="40" HorizontalAlignment="Right" Margin="0,16,0,0" Style="{StaticResource ButtonPrimary}" IsCancel="True" />
  </Grid>
</Window>
