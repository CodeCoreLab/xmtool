<?xml version="1.0" encoding="utf-8"?>
<!-- 设置窗口（v2.1.1 重设计）：1:1 还原 mstsc 原版设置窗布局。
     左侧导航栏（图标 + 标题 + 五项列表）+ 右侧彩色页头 + 设置卡片 + 底部关闭按钮。
     直接绑定 Owner 的 MainViewModel：所有选项都是 VM 的公共可观察属性，
     开关写回由 OnXxxChanged 持久化；自定义档经 WithCustomDisplayArgs 单入口合并。
     修复：v2.1.0 的 ComboBox 绑定 int 字段到 string 选项列表导致显示空白 ——
     全部 int 选项改走 Display 桥接属性（int↔string），string[] 选项直接绑定。 -->
<Window x:Class="RemoteDesktopPlus.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设置" Width="800" Height="640" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource CanvasBrush}" Icon="/app.ico" ShowInTaskbar="False">
  <Window.Resources>
    <!-- 页面图标徽标：色块 + 同色几何图形 -->
    <Style x:Key="PageBadge" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 设置行：左标题/描述 + 右控件，行间用发丝线分隔 -->
    <Style x:Key="SettingRow" TargetType="{x:Type Grid}">
      <Setter Property="Margin" Value="22,18,22,18" />
    </Style>
    <Style x:Key="RowTitle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style x:Key="RowDesc" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <!-- 行控件统一样式：下拉右对齐、固定宽（内边距防截断） -->
    <Style x:Key="RowCombo" TargetType="{x:Type ComboBox}">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Width" Value="200" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <!-- 原版卡片阴影：#0B1A2E op0.04 blur16 dir270（baml 硬证据） -->
    <Style x:Key="ShadowCard" TargetType="{x:Type Border}" BasedOn="{StaticResource CardElevated}">
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#0B1A2E" Opacity="0.04" BlurRadius="16" ShadowDepth="2" Direction="270" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RowSection" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}" />
      <Setter Property="Margin" Value="24,12,0,2" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <!-- ═══ 左侧导航栏 ═══ -->
    <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="24,28,24,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- 大图标徽标：蓝色渐变圆角方块 + 齿轮 -->
        <Border Grid.Row="0" Width="48" Height="48" CornerRadius="13" Background="{StaticResource AccentGradientBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect Color="#2563EB" Opacity="0.55" BlurRadius="24" ShadowDepth="3" Direction="270" />
          </Border.Effect>
          <Path Width="24" Height="24" Stretch="Uniform" Fill="#FFFFFFFF" Data="M12,8.6 A3.4,3.4 0 1 0 12,15.4 A3.4,3.4 0 1 0 12,8.6 M12,2.2 L13.1,2.2 A0.9,0.9 0 0 1 14,2.9 L14.4,4.7 A7.6,7.6 0 0 1 16.4,5.9 L18.1,5.2 A0.9,0.9 0 0 1 19.1,5.6 L20.2,7.5 A0.9,0.9 0 0 1 20,8.5 L18.7,9.8 A7.6,7.6 0 0 1 18.7,10.2 L20,11.5 A0.9,0.9 0 0 1 20.2,12.5 L19.1,14.4 A0.9,0.9 0 0 1 18.1,14.8 L16.4,14.1 A7.6,7.6 0 0 1 14.4,15.3 L14,17.1 A0.9,0.9 0 0 1 13.1,17.8 L12,17.8 L10.9,17.8 A0.9,0.9 0 0 1 10,17.1 L9.6,15.3 A7.6,7.6 0 0 1 7.6,14.1 L5.9,14.8 A0.9,0.9 0 0 1 4.9,14.4 L3.8,12.5 A0.9,0.9 0 0 1 4,11.5 L5.3,10.2 A7.6,7.6 0 0 1 5.3,9.8 L4,8.5 A0.9,0.9 0 0 1 3.8,7.5 L4.9,5.6 A0.9,0.9 0 0 1 5.9,5.2 L7.6,5.9 A7.6,7.6 0 0 1 9.6,4.7 L10,2.9 A0.9,0.9 0 0 1 10.9,2.2 Z" />
        </Border>
        <StackPanel Grid.Row="1" Margin="0,16,0,20">
          <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
          <TextBlock Text="个性化的连接体验" FontSize="11.5" Foreground="{StaticResource InkMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <!-- 五项导航。ListBox 承载，SelectedIndex 双向驱动右侧 TabControl。 -->
        <ListBox Grid.Row="2" Name="NavList" BorderThickness="0" Background="Transparent" Padding="0" SelectionChanged="NavList_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="{x:Type ListBoxItem}">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="12,10" />
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border Name="Bd" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBgBrush}" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsSelected" Value="True" />
                          <Condition Property="IsMouseOver" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBgBrush}" />
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBoxItem IsSelected="True">
            <StackPanel Orientation="Horizontal">
              <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform" Stroke="#FFFFFFFF" StrokeThickness="1.6" Data="M3,5 L21,5 L21,16 L3,16 Z M3,19.5 L21,19.5" />
              </Border>
              <TextBlock Text="窗口" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal">
              <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource MintBrush}" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform" Stroke="#FFFFFFFF" StrokeThickness="1.6" Data="M3,4 L21,4 L21,15 L3,15 Z M8,20 L16,20" />
              </Border>
              <TextBlock Text="显示" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal">
              <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource PeachBrush}" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform" Stroke="#FFFFFFFF" StrokeThickness="1.6" Data="M4,6 L20,6 L20,18 L4,18 Z" />
              </Border>
              <TextBlock Text="本地资源" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal">
              <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource LavenderBrush}" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform" Fill="#FFFFFFFF" Data="M13,2 L5,13 L11,13 L10,22 L19,10 L13,10 Z" />
              </Border>
              <TextBlock Text="体验" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal">
              <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource RoseBrush}" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform" Stroke="#FFFFFFFF" StrokeThickness="1.6" Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z" />
              </Border>
              <TextBlock Text="高级" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
        <TextBlock Grid.Row="4" Name="FooterVersion" Text="v0.0.0" FontSize="11" Foreground="{StaticResource InkFaintBrush}" HorizontalAlignment="Center" />
      </Grid>
    </Border>
    <!-- ═══ 右侧内容区 ═══ -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TabControl Name="NavTabs" Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="0" SelectedIndex="{Binding SelectedIndex, ElementName=NavList, Mode=TwoWay}">
        <TabControl.Template>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <ContentPresenter ContentSource="SelectedContent" />
          </ControlTemplate>
        </TabControl.Template>
        <!-- ─── 页 1：窗口行为 ─── -->
        <TabItem Header="窗口" HeaderStringFormat="">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,20">
              <!-- 彩色页头 -->
              <Grid Margin="0,24,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PageBadge}" Background="{StaticResource AccentSoftBgBrush}">
                  <Path Width="24" Height="24" Stretch="Uniform" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" Data="M3,5 L21,5 L21,16 L3,16 Z M3,19.5 L21,19.5" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="窗口行为" FontSize="19" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                  <TextBlock Text="配置关闭、最小化、托盘和自启动行为" FontSize="11.5" Foreground="{StaticResource InkMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
              <!-- 卡片：托盘/置顶/自启 -->
              <Border Style="{StaticResource ShadowCard}" Padding="0,4">
                <StackPanel>
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="多显示器" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="将所有监视器用于远程会话" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding UseMultiMon}" VerticalAlignment="Center" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="颜色深度" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="选择远程会话的颜色深度" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource RowCombo}" Width="180" ItemsSource="{Binding ColorDepthOptions}" SelectedItem="{Binding SelectedColorDepthDisplay}" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="全屏连接栏" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="全屏显示时在顶部显示连接栏" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowConnectionBar}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <!-- ─── 页 2：显示配置 ─── -->
        <TabItem Header="显示">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,20">
              <Grid Margin="0,24,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PageBadge}" Background="{StaticResource MintSoftBrush}">
                  <Path Width="24" Height="24" Stretch="Uniform" Stroke="{StaticResource MintBrush}" StrokeThickness="1.8" Data="M3,4 L21,4 L21,15 L3,15 Z M8,20 L16,20" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="显示配置" FontSize="19" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                  <TextBlock Text="远程桌面大小与颜色深度（发起连接时写入 .rdp）" FontSize="11.5" Foreground="{StaticResource InkMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource ShadowCard}" Padding="0,4">
                <StackPanel>
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="多显示器" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="将所有监视器用于远程会话" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding UseMultiMon}" VerticalAlignment="Center" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="颜色深度" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="选择远程会话的颜色深度" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource RowCombo}" Width="180" ItemsSource="{Binding ColorDepthOptions}" SelectedItem="{Binding SelectedColorDepthDisplay}" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="全屏连接栏" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="全屏显示时在顶部显示连接栏" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowConnectionBar}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ─── 页 3：本地资源 ─── -->
        <TabItem Header="本地资源">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,20">
              <Grid Margin="0,24,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PageBadge}" Background="{StaticResource PeachSoftBrush}">
                  <Path Width="24" Height="24" Stretch="Uniform" Stroke="{StaticResource PeachBrush}" StrokeThickness="1.8" Data="M4,6 L20,6 L20,18 L4,18 Z" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="本地资源" FontSize="19" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                  <TextBlock Text="音频、键盘和本地设备重定向" FontSize="11.5" Foreground="{StaticResource InkMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource ShadowCard}" Padding="0,4">
                <StackPanel>
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="远程音频" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="配置远程音频播放位置" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource RowCombo}" ItemsSource="{Binding AudioModeOptions}" SelectedItem="{Binding SelectedAudioModeDisplay}" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="键盘组合键" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="应用 Windows 组合键的位置" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource RowCombo}" ItemsSource="{Binding KeyboardHookOptions}" SelectedItem="{Binding SelectedKeyboardHookDisplay}" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="打印机重定向" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="在远程会话中使用本地打印机" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding RedirectPrinters}" VerticalAlignment="Center" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="剪贴板重定向" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="在远程会话中共享剪贴板（主界面「显示与挂载」区同源；分组级覆盖仍然优先生效）" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding RedirectClipboard}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <!-- ─── 页 4：体验 ─── -->
        <TabItem Header="体验">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,20">
              <Grid Margin="0,24,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PageBadge}" Background="{StaticResource LavenderSoftBrush}">
                  <Path Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource LavenderBrush}" Data="M13,2 L5,13 L11,13 L10,22 L19,10 L13,10 Z" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="体验" FontSize="19" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                  <TextBlock Text="优化连接速度与视觉效果" FontSize="11.5" Foreground="{StaticResource InkMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource ShadowCard}" Padding="0,4" Margin="0,0,0,14">
                <StackPanel>
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="连接速度" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="选择连接速度来优化性能" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource RowCombo}" Width="220" ItemsSource="{Binding ConnectionTypeOptions}" SelectedItem="{Binding SelectedConnectionTypeDisplay}" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource ShadowCard}" Padding="0,4">
                <StackPanel>
                  <TextBlock Style="{StaticResource RowSection}" Text="视觉效果" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowTitle}" Text="桌面背景" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowWallpaperDisplay}" VerticalAlignment="Center" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowTitle}" Text="字体平滑" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding AllowFontSmoothing}" VerticalAlignment="Center" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowTitle}" Text="桌面合成" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding AllowDesktopComposition}" VerticalAlignment="Center" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowTitle}" Text="拖动时显示窗口内容" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowWindowDragDisplay}" VerticalAlignment="Center" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowTitle}" Text="菜单和窗口动画" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowMenuAnimsDisplay}" VerticalAlignment="Center" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowTitle}" Text="视觉样式" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowThemesDisplay}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource ShadowCard}" Padding="0,4" Margin="0,14,0,0">
                <StackPanel>
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="持久位图缓存" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="缓存位图以提升重复画面性能" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding BitmapCachePersist}" VerticalAlignment="Center" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="自动重新连接" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="连接中断时自动重新连接" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoReconnect}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <!-- ─── 页 5：高级 ─── -->
        <TabItem Header="高级">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,20">
              <Grid Margin="0,24,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PageBadge}" Background="{StaticResource RoseSoftBrush}">
                  <Path Width="24" Height="24" Stretch="Uniform" Stroke="{StaticResource RoseBrush}" StrokeThickness="1.8" Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="高级" FontSize="19" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                  <TextBlock Text="服务器身份验证与安全选项" FontSize="11.5" Foreground="{StaticResource InkMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource ShadowCard}" Padding="0,4">
                <StackPanel>
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="身份验证失败时" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="服务器身份验证策略" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource RowCombo}" Width="220" ItemsSource="{Binding AuthLevelOptions}" SelectedItem="{Binding SelectedAuthLevelDisplay}" />
                  </Grid>
                  <Separator Background="{StaticResource HairlineBrush}" Margin="24,0" />
                  <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitle}" Text="Web 帐户登录" />
                      <TextBlock Style="{StaticResource RowDesc}" Text="使用 Web 帐户登录远程计算机" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="False" VerticalAlignment="Center" IsEnabled="False" ToolTip="保留项：枢联当前未实现 Web 账户认证通道" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <!-- 底部按钮条 -->
      <Border Grid.Row="1" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{StaticResource CanvasBrush}" Padding="24,14">
        <Button Content="关 闭" MinWidth="110" Height="38" HorizontalAlignment="Right" Style="{StaticResource ButtonPrimary}" IsCancel="True" Click="Close_Click" />
      </Border>
    </Grid>
  </Grid>
</Window>
