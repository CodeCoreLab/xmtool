<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RemoteDesktopPlus.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="小马远程桌面" Width="380" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="{StaticResource WarmCanvasBrush}" Icon="/app.ico" xmlns:views="clr-namespace:RemoteDesktopPlus.Views;assembly=小马远程桌面">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Width="52" Height="52" CornerRadius="14" Background="{StaticResource AccentGradientBrush}" HorizontalAlignment="Left">
      <UIElement.Effect>
        <DropShadowEffect Color="#2563EB" Opacity="0.48" BlurRadius="20" ShadowDepth="4" Direction="270" />
      </UIElement.Effect>
      <Grid>
        <Border CornerRadius="14,14,0,0" VerticalAlignment="Top" Height="18" Background="{StaticResource CardTopHighlightBrush}" />
        <Path Width="22" Height="22" Stretch="Uniform" Fill="#FFFFFFFF" Data="M12,1 C8.69,1 6,3.69 6,7 L6,11 L4,11 L4,21 L20,21 L20,11 L18,11 L18,7 C18,3.69 15.31,1 12,1 M12,3 C14.21,3 16,4.79 16,7 L16,11 L8,11 L8,7 C8,4.79 9.79,3 12,3" />
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="启动密码" Style="{StaticResource DisplayTitle}" FontSize="22" Margin="0,20,0,4" />
    <TextBlock Grid.Row="2" Text="本程序已启用密码保护，请输入正确密码后继续。" Style="{StaticResource HelperText}" Margin="0,0,0,18" />
    <StackPanel Grid.Row="3">
      <PasswordBox Name="PwdBox" KeyDown="PwdBox_KeyDown" />
      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="1" Content="退出" MinWidth="80" Margin="0,0,8,0" Click="Cancel_Click" />
        <Button Grid.Column="2" Content="登 录" MinWidth="100" Style="{StaticResource ButtonPrimary}" IsDefault="True" Click="Ok_Click" />
      </Grid>
    </StackPanel>
  </Grid>
</Window>