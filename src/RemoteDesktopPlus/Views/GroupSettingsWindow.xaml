<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RemoteDesktopPlus.Views.GroupSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="分组设置" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource CanvasBrush}" Icon="/app.ico">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="分组设置" Style="{StaticResource DisplayTitle}" FontSize="20" Margin="0,0,0,4" />
      <TextBlock Style="{StaticResource HelperText}" TextWrapping="Wrap">
        <Run Text="为选定分组覆盖连接参数。未勾选「覆盖」的项一律继承全局设置。" />
        <LineBreak />
        <Run Text="只填需要与本组不同的项——这样改全局值时，本组会跟着变。" Foreground="{StaticResource InkSubtleBrush}" />
      </TextBlock>
    </StackPanel>

    <StackPanel Grid.Row="1">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <TextBlock Style="{StaticResource Eyebrow}" Text="分组" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Name="GroupNameText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>

      <Border Style="{StaticResource InsetBlock}" Padding="14" Margin="0,0,0,10">
        <StackPanel>
          <CheckBox Name="OverrideResolution" Content="覆盖分辨率" Margin="0,0,0,8" Checked="Override_Changed" Unchecked="Override_Changed" />
          <ComboBox Name="ResolutionBox" MinHeight="36" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource InsetBlock}" Padding="14" Margin="0,0,0,10">
        <StackPanel>
          <CheckBox Name="OverrideClipboard" Content="覆盖剪贴板共享" Checked="Override_Changed" Unchecked="Override_Changed" />
          <CheckBox Name="ClipboardValue" Content="启用剪贴板共享" Margin="22,8,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource InsetBlock}" Padding="14" Margin="0,0,0,10">
        <StackPanel>
          <CheckBox Name="OverrideDrive" Content="覆盖本地磁盘共享" Checked="Override_Changed" Unchecked="Override_Changed" />
          <StackPanel Margin="22,8,0,0">
            <CheckBox Name="DriveValue" Content="启用本地磁盘共享" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="共享范围" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <ComboBox Name="DriveLetterBox" Width="140" MinHeight="34" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <Button Content="清除本组全部覆盖（恢复全继承）" Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="14,8" Click="ClearAll_Click" />
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" Content="取消" MinWidth="80" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Grid.Column="2" Content="保存" MinWidth="100" Style="{StaticResource ButtonPrimary}" IsDefault="True" Click="Ok_Click" />
    </Grid>
  </Grid>
</Window>
