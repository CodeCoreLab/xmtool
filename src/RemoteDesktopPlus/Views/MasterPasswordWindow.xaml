<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RemoteDesktopPlus.Views.MasterPasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="主密码" Width="450" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource CanvasBrush}" Icon="/app.ico" xmlns:views="clr-namespace:RemoteDesktopPlus.Views;assembly=远程桌面连接++">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Style="{StaticResource DisplayTitle}" FontSize="20" Margin="0,0,0,4" Text="{Binding TitleText, RelativeSource={RelativeSource AncestorType=Window}}" />
      <TextBlock Style="{StaticResource HelperText}" Text="设置主密码后，所有保存的远程登录密码会用 AES-GCM 加密。换电脑后只要主密码相同就能解密，可用于跨机器迁移。" />
    </StackPanel>
    <StackPanel Grid.Row="1">
      <TextBlock Style="{StaticResource Eyebrow}" Text="原主密码（无则留空）" Margin="0,0,0,6" Visibility="{Binding ShowOldPassword, RelativeSource={RelativeSource AncestorType=Window}}" />
      <PasswordBox Name="OldPwd" Margin="0,0,0,14" Visibility="{Binding ShowOldPassword, RelativeSource={RelativeSource AncestorType=Window}}" />
      <TextBlock Style="{StaticResource Eyebrow}" Text="新主密码" Margin="0,0,0,6" />
      <PasswordBox Name="NewPwd" Margin="0,0,0,14" />
      <TextBlock Style="{StaticResource Eyebrow}" Text="确认新主密码" Margin="0,0,0,6" />
      <PasswordBox Name="ConfirmPwd" />
    </StackPanel>
    <Grid Row="2" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" Content="取消" MinWidth="80" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Grid.Column="2" Content="确定" MinWidth="100" Style="{StaticResource ButtonPrimary}" IsDefault="True" Click="Ok_Click" />
    </Grid>
  </Grid>
</Window>