<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="UiFont">Inter, Microsoft YaHei UI, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Inter, Microsoft YaHei UI, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">JetBrains Mono, Consolas, Cascadia Mono, monospace</FontFamily>
  <Style x:Key="Card" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="18" />
    <Setter Property="Border.Padding" Value="22" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="UIElement.Effect">
      <Setter.Value>
        <DropShadowEffect Color="#0B1020" Opacity="0.06" BlurRadius="30" ShadowDepth="6" Direction="270" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CardElevated" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
    <Setter Property="Border.CornerRadius" Value="22" />
    <Setter Property="UIElement.Effect">
      <Setter.Value>
        <DropShadowEffect Color="#0B1020" Opacity="0.11" BlurRadius="56" ShadowDepth="16" Direction="270" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="InsetBlock" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource SurfaceTintBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="14" />
    <Setter Property="Border.Padding" Value="16" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="Eyebrow" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>
  <Style x:Key="DisplayTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>
  <Style x:Key="HelperText" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SectionAccentBar" TargetType="{x:Type Border}">
    <Setter Property="Width" Value="3.5" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Border.CornerRadius" Value="999" />
    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <Style x:Key="ButtonBase" TargetType="{x:Type Button}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <Style x:Key="ButtonPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="UIElement.Effect">
      <Setter.Value>
        <DropShadowEffect Color="#2563EB" Opacity="0.30" BlurRadius="16" ShadowDepth="3" Direction="270" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10">
            <Grid>
              <Border CornerRadius="10,10,0,0" VerticalAlignment="Top" Height="14" IsHitTestVisible="False" Background="{StaticResource CardTopHighlightBrush}" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource AccentGradientHoverBrush}" />
              <Setter Property="UIElement.Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#2563EB" Opacity="0.42" BlurRadius="20" ShadowDepth="4" Direction="270" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource AccentPressBrush}" />
              <Setter Property="UIElement.Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#2563EB" Opacity="0.22" BlurRadius="10" ShadowDepth="1" Direction="270" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Surface3Brush}" />
              <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}" />
              <Setter Property="UIElement.Effect" Value="{x:Null}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ButtonSecondary" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10">
            <UIElement.Effect>
              <DropShadowEffect Color="#0F172A" Opacity="0.05" BlurRadius="8" ShadowDepth="1.5" Direction="270" />
            </UIElement.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Surface2Brush}" />
              <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Surface3Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="UIElement.Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ButtonGhost" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bd" Background="{TemplateBinding Control.Background}" CornerRadius="10">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource HoverOverlayBrush}" />
              <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource PressOverlayBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonSecondary}" />
  <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Surface2Brush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Surface3Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="TextBoxBase.SelectionOpacity" Value="0.25" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
            <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Focusable="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource InkSubtleBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Bd" Property="UIElement.Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#2563EB" Opacity="0.22" BlurRadius="14" ShadowDepth="0" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="UIElement.Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type PasswordBox}" TargetType="{x:Type PasswordBox}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="PasswordBox.CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="PasswordBox.PasswordChar" Value="●" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type PasswordBox}">
          <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
            <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Focusable="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource InkSubtleBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Bd" Property="UIElement.Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#2563EB" Opacity="0.22" BlurRadius="14" ShadowDepth="0" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border Name="Bd" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" CornerRadius="6">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource AccentSoftBgBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource AccentSoftBgBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Grid.Column="0" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" IsHitTestVisible="False" />
              <TextBox Name="PART_EditableTextBox" Grid.Column="0" Visibility="Collapsed" Background="#00FFFFFF" BorderThickness="0" Padding="{TemplateBinding Control.Padding}" VerticalAlignment="Center" IsReadOnly="{TemplateBinding ComboBox.IsReadOnly}" Foreground="{StaticResource InkBrush}" CaretBrush="{StaticResource AccentBrush}" />
              <ToggleButton Name="PART_DropDownToggle" Grid.Column="0" Grid.ColumnSpan="2" Background="#00FFFFFF" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="#00FFFFFF" />
                  </ControlTemplate>
                </Control.Template>
              </ToggleButton>
              <Path Grid.Column="1" Data="M0,0 L8,0 L4,5" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Fill="{StaticResource InkSubtleBrush}" />
            </Grid>
            <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Slide">
              <Border BorderThickness="1" CornerRadius="10" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" Padding="6" Margin="0,6,0,0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource HairlineStrongBrush}">
                <UIElement.Effect>
                  <DropShadowEffect Color="#0F172A" Opacity="0.16" BlurRadius="32" ShadowDepth="8" />
                </UIElement.Effect>
                <ScrollViewer MaxHeight="280">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource InkSubtleBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Bd" Property="UIElement.Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#2563EB" Opacity="0.22" BlurRadius="14" ShadowDepth="0" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="ComboBox.IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
            <Border Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.2" VerticalAlignment="Center" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource HairlineStrongBrush}">
              <Path Name="Check" Data="M3,8 L7.5,12.5 L14,5" Stroke="#FFFFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Box" Property="Border.Background" Value="{StaticResource AccentGradientBrush}" />
              <Setter TargetName="Box" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type Menu}" TargetType="{x:Type Menu}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border Name="Bd" Background="{TemplateBinding Control.Background}" CornerRadius="7" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
              <TextBlock Grid.Column="1" Text="{TemplateBinding MenuItem.InputGestureText}" FontSize="11" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}" />
              <Path Name="Arrow" Grid.Column="2" Data="M0,0 L4,4 L0,8" Margin="12,0,2,0" VerticalAlignment="Center" Visibility="Collapsed" Fill="{StaticResource InkSubtleBrush}" />
              <Popup Name="PART_Popup" AllowsTransparency="True" Placement="Right" HorizontalOffset="-4" VerticalOffset="-7" Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Margin="6" CornerRadius="12" BorderThickness="1" Padding="6" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource HairlineStrongBrush}">
                  <UIElement.Effect>
                    <DropShadowEffect Color="#0B1A2E" Opacity="0.18" BlurRadius="28" ShadowDepth="6" />
                  </UIElement.Effect>
                  <ScrollViewer>
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="MenuItem.Role" Value="SubmenuHeader">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="MenuItem.Role" Value="TopLevelHeader">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="MenuItem.IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource AccentSoftBgBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentSoftTextBrush}" />
              <Setter TargetName="Arrow" Property="Shape.Fill" Value="{StaticResource AccentSoftTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ContextMenu}" TargetType="{x:Type ContextMenu}">
    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="ContextMenu.HasDropShadow" Value="False" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Margin="6" CornerRadius="12" BorderThickness="1" Padding="6" SnapsToDevicePixels="True" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource HairlineStrongBrush}">
            <UIElement.Effect>
              <DropShadowEffect Color="#0B1A2E" Opacity="0.18" BlurRadius="28" ShadowDepth="6" />
            </UIElement.Effect>
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="MenuSeparatorTemplate" TargetType="{x:Type Separator}">
    <Border Height="1" Margin="6,5" Background="{StaticResource HairlineBrush}" />
  </ControlTemplate>
  <Style x:Key="{x:Type Separator}" TargetType="{x:Type Separator}">
    <Setter Property="Template" Value="{StaticResource MenuSeparatorTemplate}" />
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
    <Setter Property="Template" Value="{StaticResource MenuSeparatorTemplate}" />
  </Style>
  <Style x:Key="{x:Type DataGrid}" TargetType="{x:Type DataGrid}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="DataGrid.GridLinesVisibility" Value="None" />
    <Setter Property="DataGrid.HeadersVisibility" Value="Column" />
    <Setter Property="DataGrid.AutoGenerateColumns" Value="False" />
    <Setter Property="DataGrid.CanUserAddRows" Value="False" />
    <Setter Property="DataGrid.CanUserDeleteRows" Value="False" />
    <Setter Property="DataGrid.CanUserResizeRows" Value="False" />
    <Setter Property="DataGrid.RowBackground" Value="#00FFFFFF" />
    <Setter Property="DataGrid.AlternatingRowBackground" Value="#00FFFFFF" />
    <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="DataGrid.VerticalGridLinesBrush" Value="#00FFFFFF" />
    <Setter Property="DataGrid.RowHeight" Value="52" />
    <Setter Property="DataGrid.ColumnHeaderHeight" Value="44" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type DataGridRow}" TargetType="{x:Type DataGridRow}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
      </Trigger>
      <Trigger Property="DataGridRow.IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource SelectionOverlayBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Style.Triggers>
      <Trigger Property="DataGridCell.IsSelected" Value="True">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border CornerRadius="3" Margin="2" Background="{StaticResource HairlineStrongBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="#00FFFFFF">
            <Track Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="#00FFFFFF" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="#00FFFFFF" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="10" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type Window}" TargetType="{x:Type Window}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Background" Value="{StaticResource WarmCanvasBrush}" />
  </Style>
</ResourceDictionary>