<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>小马远程桌面</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>11.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
    <!--
      WFAC010：WinForms 分析器要求把高 DPI 从 app.manifest 挪到 ApplicationHighDpiMode。
      本项目是 WPF 主体，PerMonitorV2 只能由 manifest 提供（ApplicationHighDpiMode 走的是
      WinForms 的运行时路径，对 WPF 窗口不生效）。WinForms 仅用于托盘 NotifyIcon，
      不涉及任何 Form 的高 DPI 布局，故保留 manifest 写法并在此显式静默该告警。
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
  <!-- 测试工程位于 tests\ 子目录；必须显式排除，否则 SDK 默认通配会把测试代码编进主程序集 -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <ApplicationDefinition Remove="tests\**" />
    <Resource Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <Analyzer Include="analyzers\CommunityToolkit.Mvvm.SourceGenerators.dll" />
    <Analyzer Include="analyzers\CommunityToolkit.Mvvm.CodeFixers.dll" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CommunityToolkit.Mvvm">
      <HintPath>libs\CommunityToolkit.Mvvm.dll</HintPath>
    </Reference>
    <Reference Include="GongSolutions.WPF.DragDrop">
      <HintPath>libs\GongSolutions.WPF.DragDrop.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Data.Sqlite">
      <HintPath>libs\Microsoft.Data.Sqlite.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.core">
      <HintPath>libs\SQLitePCLRaw.core.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.provider.e_sqlite3">
      <HintPath>libs\SQLitePCLRaw.provider.e_sqlite3.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2">
      <HintPath>libs\SQLitePCLRaw.batteries_v2.dll</HintPath>
    </Reference>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" />
  </ItemGroup>
</Project>
