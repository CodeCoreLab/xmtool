<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    枢联信创服务版（方案 B′：ASP.NET Core 服务化平移）
    选型依据 → 工作区《枢联信创改造架构选型方案-v1.1》§3
    边界定义 → 工作区《枢联B′-M1模块边界清单》§1/§5

    平移策略（K1 两步走·第一步）：Shared/All.Services.cs 为机械切片
    （generate.py 生成，S01-S17 区段，零语义修改），编译期以
    <Compile Include> 引入。后续第二步按区段拆独立文件时，
    删除本 Include 并逐个添加拆分文件即可，工程结构不变。

    K3 = net8.0（LTS；源项目 net10.0-windows 的 WPF TFM 本工程无需）。
    S08/S13/S15/S16 若引用 WPF 类型，编译报错在第一轮暴露——
    那是「实测确认」环节，不预防性修改。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RemoteDesktopPlus.Server</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- self-contained 单文件（M4 CI 三架构），开发期默认 framework-dependent -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- S03/S04 Models 用 [ObservableProperty] 源生成器（CommunityToolkit.Mvvm），
         纯托管实现无 WPF 依赖——源项目原样依赖平移 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- S08 CryptoService 的 D1$（DPAPI）走 System.Security.Cryptography.ProtectedData
         ——Windows-only 包，Linux 上由 L1$ 分支替代（M2/M3）；net8 起需显式引用 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- S07 DatabaseService / S08 CryptoService 依赖（版本对齐源项目跨 TFM 可用版） -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- 机械切片：S01-S17（Models + Services），generate.py 生成 -->
    <Compile Include="Shared/All.Services.cs" />
  </ItemGroup>

</Project>
